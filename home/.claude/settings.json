{
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "permissions": {
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terragrunt apply:*)",
      "Bash(terragrunt destroy:*)",
      "Bash(terragrunt run-all:*)",
      "Bash(kubectl delete:*)"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(./.env*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)"
    ]
  },
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/Users/harry-nix/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
