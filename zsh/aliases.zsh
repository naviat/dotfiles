alias tf='terraform'
alias tg='terragrunt'
alias tfmt='terraform fmt --recursive'
alias clear-tg='rm -rf .terraform.lock.hcl .terragrunt-cache'
alias c='clear'
alias k9s='k9s --logoless'
alias vim='nvim'
alias vi='nvim'
alias pm='podman'
alias av='aws-vault'
alias ave='aws-vault exec'
alias prophet='export AWS_PROFILE=default'
alias vhaii='export AWS_PROFILE=vhaii'
alias agcd-auto='argocd-autopilot'
alias diff='colordiff'
alias grep='grep --color=auto'
alias h='history'
alias j='jobs -l'
alias path='echo -e ${PATH//:/\\n}'
alias header='curl -I'
alias headerc='curl -I --compress'
alias fastping='ping -c 100 -s 2 -i 0.2'
alias now='date +"%T"'
alias nowdate='date +"%d-%m-%Y"'
alias nowweek='date "+%V"'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias start-day='gcloud auth login && gcloud auth application-default login'
alias wget='wget -c'

# kubernetes (k, kgp, etc. already come from the oh-my-zsh kubectl plugin)
alias kctx='kubectx'
alias kns='kubens'
alias kse='kubectl get secret'
alias kt='kubectl top'
alias ktn='kubectl top nodes'
alias ktp='kubectl top pods'
alias kpac='kubectl-resource_capacity'
alias kva='kubectl view-allocations'
alias kice='kubectl-ice'
alias rbaclp='rbac-lookup'
alias kevent="kubectl get events --sort-by='.lastTimestamp' -w"
alias ds='decode_kubernetes_secret'

# peco-style global aliases, rewritten for fzf
alias -g C='$(git log --oneline | fzf | cut -d" " -f1)'
alias -g B='$(git branch -a | fzf --prompt "GIT BRANCH> " | head -n 1 | sed -e "s/^\*\s*//g")'

